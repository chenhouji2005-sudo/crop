"""
GBCA-Ensemble: Gradient Boosted Cross-Attention Ensemble Network
Remote Sensing Agricultural Land-Cover Classification Scheme.

GitHub Release / Modular Version
"""

import os
import sys
import gc
import random
import argparse
import warnings
import joblib
import numpy as np
import pandas as pd
import geopandas as gpd
import rasterio
import matplotlib.pyplot as plt
import seaborn as sns

import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
from torch.utils.data import TensorDataset, DataLoader

import lightgbm as lgb
import xgboost as xgb
from sklearn.ensemble import RandomForestClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score, cohen_kappa_score, confusion_matrix, classification_report
from sklearn.model_selection import GroupKFold
from sklearn.utils.class_weight import compute_class_weight
from scipy.optimize import minimize
from tqdm import tqdm

warnings.filterwarnings('ignore')


def seed_everything(seed=42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed(seed)
        torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = True


# ===================== GBCA_Emb Network =====================
class GBCA_Emb_Fast(nn.Module):
    def __init__(self, spec_dim, n_tree, max_leaf_list, emb_dim, hidden_dim, n_class, dropout, n_head):
        super().__init__()
        self.n_tree = n_tree
        self.emb_dim = emb_dim

        leaf_counts = np.array(max_leaf_list, dtype=np.int64)
        offsets = np.zeros(n_tree, dtype=np.int64)
        offsets[1:] = np.cumsum(leaf_counts)[:-1]
        self.register_buffer("offsets", torch.from_numpy(offsets).long())

        self.total_vocab_size = int(np.sum(leaf_counts))
        self.global_tree_embed = nn.Embedding(self.total_vocab_size, emb_dim)
        nn.init.xavier_uniform_(self.global_tree_embed.weight)

        self.spec_embed = nn.Sequential(
            nn.Linear(spec_dim, hidden_dim),
            nn.BatchNorm1d(hidden_dim),
            nn.GELU(),
            nn.Dropout(dropout)
        )
        self.leaf_agg_proj = nn.Sequential(
            nn.Linear(emb_dim, hidden_dim),
            nn.BatchNorm1d(hidden_dim),
            nn.GELU(),
            nn.Dropout(dropout)
        )
        self.cross_attn = nn.MultiheadAttention(
            embed_dim=hidden_dim,
            num_heads=n_head,
            batch_first=True,
            dropout=dropout
        )
        self.gate = nn.Sequential(
            nn.Linear(hidden_dim * 2, hidden_dim),
            nn.Sigmoid()
        )
        self.classifier = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_dim, n_class)
        )

    def forward(self, spec_x, leaf_index):
        global_leaf_index = leaf_index + self.offsets
        global_leaf_index = torch.clamp(global_leaf_index, min=0, max=self.total_vocab_size - 1)

        tree_emb_stack = self.global_tree_embed(global_leaf_index)
        tree_emb_mean = torch.mean(tree_emb_stack, dim=1)

        leaf_feat = self.leaf_agg_proj(tree_emb_mean)
        spec_feat = self.spec_embed(spec_x)

        q = spec_feat.unsqueeze(1)
        k = leaf_feat.unsqueeze(1)
        v = leaf_feat.unsqueeze(1)
        attn_out, _ = self.cross_attn(q, k, v)
        attn_out = attn_out.squeeze(1)

        gate_w = self.gate(torch.cat([spec_feat, attn_out], dim=1))
        fused = gate_w * spec_feat + (1 - gate_w) * attn_out
        return self.classifier(fused)


# ===================== Helper Functions =====================
def get_leaf_batch(model, X, num_classes, batch=8000):
    leaf_list = []
    n = X.shape[0]
    for s in range(0, n, batch):
        e = min(s + batch, n)
        blk = model.predict(X[s:e, :], pred_leaf=True, num_threads=1)
        blk_slim = blk[:, ::num_classes]
        leaf_list.append(blk_slim)
        del blk
        gc.collect()
    return np.vstack(leaf_list)


def extract_samples_with_group(shp_path, img, transform, raster_crs, band_names, class_col, raw_to_label, nodata_value,
                               sample_nodata_ratio, id_prefix=0):
    gdf = gpd.read_file(shp_path, encoding="utf-8")
    gdf = gdf[gdf.geometry.notna()].reset_index(drop=True)
    gdf = gdf[gdf[class_col].isin(raw_to_label.keys())].reset_index(drop=True)

    if raster_crs is not None and gdf.crs != raster_crs:
        try:
            gdf = gdf.to_crs(raster_crs)
        except Exception as e:
            print(f"[Warning] CRS align warning: {e}")

    try:
        if gdf.crs and gdf.crs.is_geographic:
            areas_ha = gdf.to_crs(epsg=3857).geometry.area / 10000.0
        else:
            areas_ha = gdf.geometry.area / 10000.0
    except Exception:
        areas_ha = gdf.geometry.to_crs("+proj=cea").area / 10000.0

    feat_list, label_list, group_list = [], [], []
    H, W = img.shape[0], img.shape[1]
    max_invalid = int(len(band_names) * sample_nodata_ratio)

    for idx, row in tqdm(gdf.iterrows(), total=len(gdf), desc=f"Sampling {os.path.basename(shp_path)}"):
        geom = row.geometry
        lab = raw_to_label[row[class_col]]
        area = areas_ha.iloc[idx]
        poly_group_id = id_prefix + idx

        max_sample = 5 if area < 0.5 else (10 if area <= 2.0 else 15)
        minx, miny, maxx, maxy = geom.bounds
        valid_count, try_times = 0, max_sample * 8

        while valid_count < max_sample and try_times > 0:
            rx, ry = np.random.uniform(minx, maxx), np.random.uniform(miny, maxy)
            pt = gpd.points_from_xy([rx], [ry])[0]
            if not geom.contains(pt):
                try_times -= 1
                continue

            col_f, row_f = ~transform * (rx, ry)
            c, r = int(np.floor(col_f)), int(np.floor(row_f))

            if not (0 <= c < W and 0 <= r < H):
                try_times -= 1
                continue

            pixel = img[r, c, :].copy()
            invalid_num = np.sum((np.isnan(pixel)) | (pixel == nodata_value))
            if invalid_num <= max_invalid:
                pixel[np.isnan(pixel)] = 0
                feat_list.append(pixel)
                label_list.append(lab)
                group_list.append(poly_group_id)
                valid_count += 1
            try_times -= 1

    sample_df = pd.DataFrame(np.vstack(feat_list), columns=band_names)
    sample_df[class_col] = label_list
    sample_df['group_id'] = group_list
    print(
        f"{os.path.basename(shp_path)} Extracted: {len(sample_df)} points covering {len(np.unique(group_list))} spatial blocks.")
    return sample_df


def save_and_plot_cm(y_true, y_pred, class_names, title, save_path):
    cm = confusion_matrix(y_true, y_pred)
    acc = accuracy_score(y_true, y_pred)
    kappa = cohen_kappa_score(y_true, y_pred)

    plt.figure(figsize=(7, 5))
    sns.heatmap(cm, annot=True, fmt="d", cmap="Blues",
                xticklabels=class_names, yticklabels=class_names)
    plt.xlabel('Predicted Label')
    plt.ylabel('True Label')
    plt.title(f'{title}\nOA: {acc:.4f} | Kappa: {kappa:.4f}')
    plt.savefig(save_path, dpi=300, bbox_inches="tight")
    plt.close()
    return acc, kappa


def parse_args():
    parser = argparse.ArgumentParser(description="GBCA-Ensemble Training & Evaluation Script")
    parser.add_argument("--train_shp", type=str, required=True, help="Path to training shapefile")
    parser.add_argument("--val_shp", type=str, required=True, help="Path to validation shapefile")
    parser.add_argument("--img_path", type=str, required=True, help="Path to input raster image (.tif)")
    parser.add_argument("--output_dir", type=str, default="./output_models",
                        help="Directory to save models and metrics")

    parser.add_argument("--class_col", type=str, default="class", help="Column name for land cover classes")
    parser.add_argument("--nodata_val", type=float, default=-9999.0, help="NoData value in raster")
    parser.add_argument("--nodata_ratio", type=float, default=0.3, help="Max ratio of allowed nodata values per sample")

    parser.add_argument("--n_splits", type=int, default=5, help="Number of splits for Spatial GroupKFold")
    parser.add_argument("--batch_size", type=int, default=128, help="Batch size for GBCA model")
    parser.add_argument("--epochs", type=int, default=120, help="Max epochs for GBCA model")
    parser.add_argument("--patience", type=int, default=15, help="Early stopping patience")
    parser.add_argument("--lr", type=float, default=1e-3, help="Learning rate")
    parser.add_argument("--weight_decay", type=float, default=1e-3, help="Weight decay for AdamW")
    parser.add_argument("--dropout", type=float, default=0.20, help="Dropout rate")
    parser.add_argument("--seed", type=int, default=42, help="Random seed")

    return parser.parse_args()


# ===================== Main Pipeline =====================
def main():
    args = parse_args()
    seed_everything(args.seed)
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')

    os.makedirs(args.output_dir, exist_ok=True)

    RAW_TO_LABEL = {1: 0, 2: 1, 3: 2, 4: 3}
    CLASS_NAMES = ['Wheat', 'Rapeseed', 'Vegetables', 'Greenhouse']
    NUM_CLASSES = len(RAW_TO_LABEL)

    # 1. Load Raster & Vector Data
    with rasterio.open(args.img_path) as src:
        img_data = np.transpose(src.read(), [1, 2, 0])
        geo_transform = src.transform
        raster_crs = src.crs
        raster_profile = src.profile.copy()
        band_names = list(src.descriptions) if src.descriptions[0] is not None else [f"Band_{i + 1}" for i in
                                                                                     range(src.count)]

    NUM_BANDS = len(band_names)

    df_train = extract_samples_with_group(
        args.train_shp, img_data, geo_transform, raster_crs, band_names,
        args.class_col, RAW_TO_LABEL, args.nodata_val, args.nodata_ratio, id_prefix=0
    )
    df_val = extract_samples_with_group(
        args.val_shp, img_data, geo_transform, raster_crs, band_names,
        args.class_col, RAW_TO_LABEL, args.nodata_val, args.nodata_ratio, id_prefix=10000
    )

    del img_data
    gc.collect()

    X_train_raw = df_train[band_names].values
    y_train = df_train[args.class_col].values
    groups_train = df_train['group_id'].values

    X_val_raw = df_val[band_names].values
    y_val = df_val[args.class_col].values

    scaler = StandardScaler()
    X_train = scaler.fit_transform(X_train_raw)
    X_val = scaler.transform(X_val_raw)

    # 2. Spatial Cross-Validation
    gkf = GroupKFold(n_splits=args.n_splits)
    oof_gbca_probs = np.zeros((len(df_train), NUM_CLASSES))
    oof_lgb_probs = np.zeros((len(df_train), NUM_CLASSES))
    oof_xgb_probs = np.zeros((len(df_train), NUM_CLASSES))
    oof_rf_probs = np.zeros((len(df_train), NUM_CLASSES))

    val_gbca_probs_fold = np.zeros((len(df_val), NUM_CLASSES))
    val_lgb_probs_fold = np.zeros((len(df_val), NUM_CLASSES))
    val_xgb_probs_fold = np.zeros((len(df_val), NUM_CLASSES))
    val_rf_probs_fold = np.zeros((len(df_val), NUM_CLASSES))

    print(f"\n==================== Running {args.n_splits}-Fold Spatial Cross Validation ====================")

    for fold, (tr_idx, va_idx) in enumerate(gkf.split(X_train, y_train, groups=groups_train)):
        print(f"\n>>>> Fold {fold + 1} / {args.n_splits} <<<<")
        X_tr, y_tr = X_train[tr_idx], y_train[tr_idx]
        X_va, y_va = X_train[va_idx], y_train[va_idx]

        # Machine Learning Base Models
        lgb_model = lgb.LGBMClassifier(
            n_estimators=300, learning_rate=0.03, num_leaves=45,
            min_child_samples=20, subsample=0.8, colsample_bytree=0.8,
            random_state=args.seed + fold, n_jobs=-1, verbose=-1
        )
        lgb_model.fit(X_tr, y_tr)
        oof_lgb_probs[va_idx] = lgb_model.predict_proba(X_va)
        val_lgb_probs_fold += lgb_model.predict_proba(X_val) / args.n_splits

        xgb_model = xgb.XGBClassifier(
            n_estimators=180, learning_rate=0.03, max_depth=4,
            subsample=0.8, colsample_bytree=0.8,
            random_state=args.seed + fold, n_jobs=4, verbosity=0
        )
        xgb_model.fit(X_tr, y_tr)
        oof_xgb_probs[va_idx] = xgb_model.predict_proba(X_va)
        val_xgb_probs_fold += xgb_model.predict_proba(X_val) / args.n_splits

        rf_model = RandomForestClassifier(
            n_estimators=150, max_depth=10, max_features='sqrt',
            random_state=args.seed + fold, n_jobs=4
        )
        rf_model.fit(X_tr, y_tr)
        oof_rf_probs[va_idx] = rf_model.predict_proba(X_va)
        val_rf_probs_fold += rf_model.predict_proba(X_val) / args.n_splits

        # Leaf Indices Extraction
        leaf_tr = get_leaf_batch(lgb_model, X_tr, NUM_CLASSES)
        leaf_va = get_leaf_batch(lgb_model, X_va, NUM_CLASSES)
        leaf_test_val = get_leaf_batch(lgb_model, X_val, NUM_CLASSES)

        N_TREE = leaf_tr.shape[1]
        lgb_tree_dump = lgb_model.booster_.dump_model()["tree_info"]
        slim_tree_dump = lgb_tree_dump[::NUM_CLASSES]
        max_leaf_list_fold = [tree["num_leaves"] + 10 for tree in slim_tree_dump]

        # GBCA Neural Network
        model = GBCA_Emb_Fast(
            spec_dim=NUM_BANDS, n_tree=N_TREE, max_leaf_list=max_leaf_list_fold,
            emb_dim=32, hidden_dim=128, n_class=NUM_CLASSES,
            dropout=args.dropout, n_head=4
        ).to(device)

        train_ds = TensorDataset(torch.from_numpy(X_tr).float(), torch.from_numpy(leaf_tr).long(),
                                 torch.from_numpy(y_tr).long())
        train_loader = DataLoader(train_ds, batch_size=args.batch_size, shuffle=True)

        val_spec_tensor = torch.from_numpy(X_va).float()
        val_leaf_tensor = torch.from_numpy(leaf_va).long()

        cls_weights = compute_class_weight('balanced', classes=np.unique(y_tr), y=y_tr)
        criterion = nn.CrossEntropyLoss(weight=torch.tensor(cls_weights, dtype=torch.float32).to(device),
                                        label_smoothing=0.1)
        optimizer = optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)
        scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode="max", factor=0.7, patience=8)

        best_kappa, early_stop_count, best_state, best_val_probs = -1.0, 0, None, None

        for ep in range(args.epochs):
            model.train()
            total_loss, correct_train, total_train = 0.0, 0, 0

            for spec_x, leaf_x, y in train_loader:
                spec_x, leaf_x, y = spec_x.to(device), leaf_x.to(device), y.to(device)
                optimizer.zero_grad()
                logits = model(spec_x, leaf_x)
                loss = criterion(logits, y)
                loss.backward()
                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
                optimizer.step()

                total_loss += loss.item() * spec_x.shape[0]
                preds_train = torch.argmax(logits, dim=1)
                correct_train += (preds_train == y).sum().item()
                total_train += spec_x.shape[0]

            train_loss = total_loss / len(X_tr)
            train_acc = correct_train / total_train

            model.eval()
            val_pred_list = []
            with torch.no_grad():
                for s in range(0, len(val_spec_tensor), args.batch_size):
                    e = min(s + args.batch_size, len(val_spec_tensor))
                    vs, vl = val_spec_tensor[s:e].to(device), val_leaf_tensor[s:e].to(device)
                    val_pred_list.append(model(vs, vl))

            val_logits = torch.cat(val_pred_list, dim=0)
            val_probs = F.softmax(val_logits, dim=1).cpu().numpy()
            val_preds = np.argmax(val_probs, axis=1)

            val_acc = accuracy_score(y_va, val_preds)
            kappa = cohen_kappa_score(y_va, val_preds)

            if (ep + 1) % 5 == 0 or kappa > best_kappa or ep == args.epochs - 1:
                print(f"Fold {fold + 1} | Epoch {ep + 1:03d}/{args.epochs} | "
                      f"Train Loss: {train_loss:.4f} | Train Acc: {train_acc:.4f} | "
                      f"OOF Acc: {val_acc:.4f} | OOF Kappa: {kappa:.4f}")

            if kappa > best_kappa:
                best_kappa, best_state, early_stop_count = kappa, model.state_dict(), 0
                best_val_probs = val_probs
            else:
                early_stop_count += 1
                if early_stop_count >= args.patience:
                    print(f"--> Fold {fold + 1} Early stopping triggered! Best OOF Kappa: {best_kappa:.4f}")
                    break
            scheduler.step(kappa)

        oof_gbca_probs[va_idx] = best_val_probs

        model.load_state_dict(best_state)
        model.eval()
        test_spec_tensor = torch.from_numpy(X_val).float()
        test_leaf_tensor = torch.from_numpy(leaf_test_val).long()
        test_pred_list = []
        with torch.no_grad():
            for s in range(0, len(test_spec_tensor), args.batch_size):
                e = min(s + args.batch_size, len(test_spec_tensor))
                ts, tl = test_spec_tensor[s:e].to(device), test_leaf_tensor[s:e].to(device)
                test_pred_list.append(model(ts, tl))
        test_logits = torch.cat(test_pred_list, dim=0)
        val_gbca_probs_fold += F.softmax(test_logits, dim=1).cpu().numpy() / args.n_splits

        if fold == args.n_splits - 1:
            torch.save({
                "state_dict": best_state, "spec_dim": NUM_BANDS, "n_tree": N_TREE,
                "max_leaf_list": max_leaf_list_fold, "emb_dim": 32,
                "hidden_dim": 128, "num_heads": 4, "dropout": args.dropout,
            }, os.path.join(args.output_dir, "gbca_checkpoint.pth"))

            joblib.dump({
                "scaler": scaler, "lgb": lgb_model, "xgb": xgb_model, "rf": rf_model,
                "band_names": band_names, "raster_profile": raster_profile
            }, os.path.join(args.output_dir, "ml_pipeline.pkl"))

    # 3. Optimize Ensemble Weights
    prob_set_oof = [oof_gbca_probs, oof_lgb_probs, oof_xgb_probs, oof_rf_probs]

    def kappa_obj(w):
        w = np.array(w) / np.sum(w)
        pred = np.argmax(sum(wi * pi for wi, pi in zip(w, prob_set_oof)), axis=1)
        return -cohen_kappa_score(y_train, pred)

    opt_res = minimize(
        kappa_obj,
        [0.2, 0.3, 0.3, 0.2],
        bounds=[(0.05, 0.6)] * 4,
        constraints={'type': 'eq', 'fun': lambda w: np.sum(w) - 1.0}
    )
    final_weights = opt_res.x / np.sum(opt_res.x)

    print("\n==================== Optimal Fusion Weights ====================")
    print("Optimization results [GBCA, LGB, XGB, RF]:", np.round(final_weights, 4))

    # 4. Final Evaluation
    prob_set_val = [val_gbca_probs_fold, val_lgb_probs_fold, val_xgb_probs_fold, val_rf_probs_fold]
    ensemble_val_prob = sum(w * p for w, p in zip(final_weights, prob_set_val))
    val_ensemble_preds = np.argmax(ensemble_val_prob, axis=1)

    models_info_val = [
        ("GBCA Deep Learning", np.argmax(val_gbca_probs_fold, axis=1), "val_cm_gbca.png"),
        ("LightGBM Model", np.argmax(val_lgb_probs_fold, axis=1), "val_cm_lgbm.png"),
        ("XGBoost Model", np.argmax(val_xgb_probs_fold, axis=1), "val_cm_xgboost.png"),
        ("Random Forest Model", np.argmax(val_rf_probs_fold, axis=1), "val_cm_rf.png"),
        ("Weighted Ensemble", val_ensemble_preds, "val_cm_ensemble.png"),
    ]

    print("\n==================== Independent Validation Evaluation ====================")
    print(f"{'Model Name':<25} | {'OA':<8} | {'Kappa':<8}")
    print("-" * 50)
    for name, preds, filename in models_info_val:
        save_filepath = os.path.join(args.output_dir, filename)
        acc, kappa = save_and_plot_cm(y_val, preds, CLASS_NAMES, name, save_filepath)
        print(f"{name:<25} | {acc:.4f}   | {kappa:.4f}")

    print("\nClassification Report (Weighted Ensemble):")
    print(classification_report(y_val, val_ensemble_preds, target_names=CLASS_NAMES, digits=4))
    print(f"\nAll models and evaluation metrics saved to: {args.output_dir}")


if __name__ == '__main__':
    main()
